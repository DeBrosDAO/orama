    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "github-slugger": "2.0.0",
    "image-size": "2.0.2",
    "puppeteer-core": "25.12.0",
    "remark-frontmatter": "5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "5.0.2",
