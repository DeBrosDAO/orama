[Unit]
Description=Orama Namespace Vault Guardian (%i)
Documentation=https://github.com/DeBrosOfficial/network
After=network-online.target orama-namespace-wireguard@%i.service
Wants=network-online.target
PartOf=orama-node.service
# No start limit. orama-node reconciles these units and retries with backoff,
# and `systemctl start` on a rate-limited unit fails with "Start request
# repeated too quickly" until someone runs `reset-failed` — so the default
# limit would turn a transient failure into one that needs a human.
StartLimitIntervalSec=0

[Service]
Type=simple
User=orama
Group=orama
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
ReadWritePaths=/opt/orama/.orama/data/vault
EnvironmentFile=-/opt/orama/.orama/data/namespaces/%i/vault.env
ExecStart=/opt/orama/bin/vault-guardian --config /opt/orama/.orama/data/vault/vault.yaml
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orama-vault-%i
PrivateTmp=yes
LimitMEMLOCK=67108864
MemoryMax=512M
MemorySwapMax=0
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
