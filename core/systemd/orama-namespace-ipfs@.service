[Unit]
Description=Orama Namespace IPFS (%i)
Documentation=https://github.com/DeBrosOfficial/network
After=network-online.target orama-namespace-wireguard@%i.service
Wants=network-online.target
PartOf=orama-node.service

[Service]
Type=simple
User=orama
Group=orama
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
ReadWritePaths=/opt/orama/.orama
EnvironmentFile=/opt/orama/.orama/data/namespaces/%i/ipfs.env
Environment=HOME=/opt/orama
ExecStartPre=/bin/bash -c 'if [ -f /opt/orama/.orama/secrets/swarm.key ] && [ ! -f ${IPFS_PATH}/swarm.key ]; then cp /opt/orama/.orama/secrets/swarm.key ${IPFS_PATH}/swarm.key && chmod 600 ${IPFS_PATH}/swarm.key; fi'
ExecStart=/usr/local/bin/ipfs daemon --enable-pubsub-experiment --repo-dir=${IPFS_PATH}
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orama-ipfs-%i
PrivateTmp=yes
LimitNOFILE=65536
TimeoutStopSec=30
KillMode=mixed
MemoryMax=4G

[Install]
WantedBy=multi-user.target
