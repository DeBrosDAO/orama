[Unit]
Description=Orama Namespace Anyone Client SOCKS5 (%i)
Documentation=https://github.com/DeBrosOfficial/network
After=network-online.target
Wants=network-online.target
PartOf=orama-node.service
# No start limit. orama-node reconciles these units and retries with backoff,
# and `systemctl start` on a rate-limited unit fails with "Start request
# repeated too quickly" until someone runs `reset-failed` — so the default
# limit would turn a transient failure into one that needs a human.
StartLimitIntervalSec=0

[Service]
Type=simple
User=debian-anon
Group=debian-anon
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
ProtectProc=invisible
EnvironmentFile=-/opt/orama/.orama/data/namespaces/%i/anyone-client.env
ExecStart=/usr/bin/anon -f /etc/anon/anonrc
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orama-anyone-client-%i
PrivateTmp=yes
LimitNOFILE=65536
TimeoutStopSec=30
KillMode=mixed
MemoryMax=1G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
