[Unit]
Description=Orama Namespace TURN (%i)
Documentation=https://github.com/DeBrosOfficial/network
After=network.target
PartOf=orama-node.service

[Service]
Type=simple
User=orama
Group=orama
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
ProtectProc=invisible
ReadWritePaths=/opt/orama/.orama/data/namespaces/%i /opt/orama/.orama/logs
InaccessiblePaths=/opt/orama/.orama/secrets
WorkingDirectory=/opt/orama

EnvironmentFile=/opt/orama/.orama/data/namespaces/%i/turn.env

ExecStart=/opt/orama/bin/turn --config ${TURN_CONFIG}

TimeoutStopSec=30s
KillMode=mixed
KillSignal=SIGTERM

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=orama-turn-%i

PrivateTmp=yes
LimitNOFILE=65536
MemoryMax=1G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
