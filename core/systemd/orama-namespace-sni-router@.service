[Unit]
Description=Orama Namespace SNI Router (%i)
Documentation=https://github.com/DeBrosOfficial/network
After=network.target
Before=orama-namespace-caddy@%i.service
PartOf=orama-node.service

[Service]
Type=simple
WorkingDirectory=/opt/orama
EnvironmentFile=-/opt/orama/.orama/data/namespaces/%i/sni-router.env
ExecStart=/opt/orama/bin/orama-sni-router --config /opt/orama/.orama/configs/sni-router.yaml

# Bind privileged ports (:80, :443) without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

User=orama
Group=orama
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536
MemorySwapMax=0

TimeoutStopSec=15s
KillMode=mixed
KillSignal=SIGTERM

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=orama-sni-router-%i

[Install]
WantedBy=multi-user.target
