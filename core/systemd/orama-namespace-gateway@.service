[Unit]
Description=Orama Namespace Gateway (%i)
Documentation=https://github.com/DeBrosOfficial/network
After=network.target orama-namespace-wireguard@index.service orama-namespace-rqlite@%i.service orama-namespace-olric@%i.service
# Wants, not Requires. Requires propagates stop AND restart, so a
# `systemctl restart orama-namespace-rqlite@<ns>` — which the split-brain
# recovery path does on its own — bounced the gateway with it: the leader wait,
# the health monitor, the cluster manager, its reconcilers and the tenant
# restore all started over, for a database restart the gateway is built to ride
# out. The gateway retries rqlite and reconnects to Olric on its own
# (initializeOlricClientWithRetry, then startOlricReconnectLoop), so ordering is
# all it needs from them.
Wants=orama-namespace-wireguard@index.service orama-namespace-rqlite@%i.service orama-namespace-olric@%i.service
PartOf=orama-node.service
# No start limit. orama-node reconciles these units and retries with backoff,
# and `systemctl start` on a rate-limited unit fails with "Start request
# repeated too quickly" until someone runs `reset-failed` — so the default
# limit would turn a transient failure into one that needs a human.
StartLimitIntervalSec=0

[Service]
Type=simple
User=orama
Group=orama
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
ProtectProc=invisible
ReadWritePaths=/opt/orama/.orama/data/namespaces/%i /opt/orama/.orama/logs /opt/orama/.orama/data /opt/orama/.orama/tls-cache
ReadOnlyPaths=/opt/orama/.orama/secrets
WorkingDirectory=/opt/orama

EnvironmentFile=/opt/orama/.orama/data/namespaces/%i/gateway.env

ExecStart=/opt/orama/bin/gateway --config ${GATEWAY_CONFIG}

TimeoutStopSec=30s
KillMode=mixed
KillSignal=SIGTERM

Restart=always
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=orama-gateway-%i

PrivateTmp=yes
LimitNOFILE=65536
MemoryMax=1G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
