[Unit]
Description=Orama Namespace Olric Cache (%i)
Documentation=https://github.com/DeBrosOfficial/network
After=network.target orama-namespace-wireguard@index.service orama-namespace-rqlite@%i.service
Wants=orama-namespace-wireguard@index.service
Requires=orama-namespace-rqlite@%i.service
PartOf=orama-node.service

[Service]
Type=simple
User=orama
Group=orama
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
ProtectProc=invisible
ReadWritePaths=/opt/orama/.orama/data/namespaces/%i /opt/orama/.orama/logs
InaccessiblePaths=/opt/orama/.orama/secrets
WorkingDirectory=/opt/orama

EnvironmentFile=/opt/orama/.orama/data/namespaces/%i/olric.env

ExecStart=/usr/local/bin/olric-server

TimeoutStopSec=30s
KillMode=mixed
KillSignal=SIGTERM

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=orama-olric-%i

PrivateTmp=yes
LimitNOFILE=65536
MemoryMax=2G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
