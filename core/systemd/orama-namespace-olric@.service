[Unit]
Description=Orama Namespace Olric Cache (%i)
Documentation=https://github.com/DeBrosOfficial/network
# Olric has no functional dependency on rqlite: it is an in-memory cache that
# talks to its own memberlist over the overlay and never reads the database. It
# used to declare Requires= AND After= on rqlite, which meant a rqlite restart
# dropped every cached entry on the node and held Olric's own start behind a
# raft convergence it does not need.
After=network.target orama-namespace-wireguard@index.service
Wants=orama-namespace-wireguard@index.service
PartOf=orama-node.service
# No start limit. orama-node reconciles these units and retries with backoff,
# and `systemctl start` on a rate-limited unit fails with "Start request
# repeated too quickly" until someone runs `reset-failed` — so the default
# limit would turn a transient failure into one that needs a human.
StartLimitIntervalSec=0

[Service]
Type=simple
User=orama
Group=orama
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
ProtectProc=invisible
ReadWritePaths=/opt/orama/.orama/data/namespaces/%i /opt/orama/.orama/logs
InaccessiblePaths=/opt/orama/.orama/secrets
WorkingDirectory=/opt/orama

EnvironmentFile=/opt/orama/.orama/data/namespaces/%i/olric.env

ExecStart=/usr/local/bin/olric-server

TimeoutStopSec=30s
KillMode=mixed
KillSignal=SIGTERM

Restart=always
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=orama-olric-%i

PrivateTmp=yes
LimitNOFILE=65536
MemoryMax=2G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
