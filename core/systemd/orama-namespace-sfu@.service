[Unit]
Description=Orama Namespace SFU (%i)
Documentation=https://github.com/DeBrosOfficial/network
After=network.target orama-namespace-wireguard@index.service orama-namespace-olric@%i.service
Wants=orama-namespace-wireguard@index.service orama-namespace-olric@%i.service
PartOf=orama-node.service
# No start limit. orama-node reconciles these units and retries with backoff,
# and `systemctl start` on a rate-limited unit fails with "Start request
# repeated too quickly" until someone runs `reset-failed` — so the default
# limit would turn a transient failure into one that needs a human.
StartLimitIntervalSec=0

[Service]
Type=simple
User=orama
Group=orama
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
ProtectProc=invisible
# The SFU reads one file, its config in its namespace's configs/ directory,
# and writes nothing. Install runs it as orama-sfu (pkg/systemd
# isolatedServices); the config is orama:orama-sfu 0640. Of /opt/orama it
# sees only that directory, bound read-only over an empty tmpfs.
TemporaryFileSystem=/opt/orama:ro
BindReadOnlyPaths=/opt/orama/.orama/data/namespaces/%i/configs
WorkingDirectory=/opt/orama

EnvironmentFile=/var/lib/orama-unit-env/%i/sfu.env

# The world-executable copy install writes (pkg/install deployPreBuiltBinaries):
# /opt/orama/bin is root:orama 0750, which orama-sfu cannot execute from.
ExecStart=/usr/local/bin/sfu --config ${SFU_CONFIG}

TimeoutStopSec=45s
KillMode=mixed
KillSignal=SIGTERM

Restart=always
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=orama-sfu-%i

PrivateTmp=yes
LimitNOFILE=65536
MemoryMax=2G
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
