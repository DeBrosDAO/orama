[Unit]
Description=Orama Namespace PubSub (%i)
Documentation=https://github.com/DeBrosOfficial/network
After=network.target orama-namespace-wireguard@index.service
Wants=orama-namespace-wireguard@index.service
PartOf=orama-node.service
# No start limit. orama-node reconciles these units and retries with backoff,
# and `systemctl start` on a rate-limited unit fails with "Start request
# repeated too quickly" until someone runs `reset-failed` — so the default
# limit would turn a transient failure into one that needs a human.
StartLimitIntervalSec=0

[Service]
Type=simple
User=orama
Group=orama
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
ProtectProc=invisible
ReadWritePaths=/opt/orama/.orama/data/namespaces/%i /opt/orama/.orama/logs
InaccessiblePaths=/opt/orama/.orama/secrets
WorkingDirectory=/opt/orama
EnvironmentFile=/var/lib/orama-unit-env/%i/pubsub.env
# The API is a unix socket in this runtime directory (pkg/pubsub
# DefaultSocketPath), 0700 and the orama user's, and admits only callers running
# as that user. It used to be 127.0.0.1:10105, which every process on the node
# — a tenant's deployment included — could publish and subscribe through, for
# any namespace.
RuntimeDirectory=orama-pubsub
RuntimeDirectoryMode=0700
ExecStart=/opt/orama/bin/pubsub
TimeoutStopSec=15s
KillMode=mixed
KillSignal=SIGTERM
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orama-pubsub-%i
PrivateTmp=yes
LimitNOFILE=65536
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
