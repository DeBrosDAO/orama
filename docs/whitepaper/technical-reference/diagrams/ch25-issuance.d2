shape: sequence_diagram

a: "Caddy on node A"
ga: "Gateway on node A"
db: "Index RQLite"
ca: "ACME CA"
dns: "CoreDNS"
b: "Caddy on node B"
gb: "Gateway on node B"

a -> ga: "stat certificates (is the store open?)"
ga -> a: "503 until legacy import is done, then 200"
a -> ga: "load certificates/<ca>/wildcard_.<base>/wildcard_.<base>.crt"
ga -> db: "SELECT value FROM tls_store"
ga -> a: "exists: false"
a -> ga: "lock (name chosen by CertMagic), holder id, lease 60 s"
ga -> db: "INSERT tls_locks ... WHERE expires < now"
ga -> a: "acquired: true"
a -> a: "renew every 20 s while working"
a -> ga: "POST /v1/internal/acme/present"
ga -> db: "INSERT dns_records TXT"
a -> ca: "new order, DNS-01"
ca -> dns: "TXT _acme-challenge.<base>"
dns -> db: "read dns_records"
ca -> a: "challenge valid, certificate"
a -> ga: "store cert, key, meta (each sealed)"
ga -> db: "INSERT tls_store"
a -> ga: "POST /v1/internal/acme/cleanup"
a -> ga: "unlock"
b -> gb: "load wildcard_.<base>.crt / .key"
gb -> db: "SELECT value FROM tls_store"
gb -> b: "sealed value"
b -> b: "open with seal key, serve"
