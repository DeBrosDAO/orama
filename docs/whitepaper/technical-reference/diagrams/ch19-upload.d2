shape: sequence_diagram

client: "client"
gw: "namespace gateway"
kubo: "local Kubo"
refs: "index RQLite\nipfs_cid_refs"
own: "namespace RQLite\nownership, quota"
cluster: "local ipfs-cluster"
peers: "other cluster peers"

client -> gw: "POST /v1/storage/upload (multipart or JSON base64)"
gw -> gw: "normalise name; storage selector check"
gw -> own: "quota: SUM(size_bytes) x RF > budget?"
gw -> gw: "ORMAW1 seal (AES-256-GCM) unless .tar.gz or .tgz"
gw -> kubo: "POST /api/v0/add?pin=true&cid-version=0\n(pin=false: same, then a cluster pin with RF -1, no Register)"
kubo -> gw: "CID (file object)"
gw -> own: "INSERT ownership (is_pinned = 0)"
gw -> refs: "Register(cid, ns, storage): holders + 1\n(registry error: 503, nothing is undone)"
gw -> client: "200 {cid, name, size}"
gw -> cluster: "async: POST /pins/cid?replication-min=max=RF"
cluster -> peers: "CRDT pinset update"
peers -> kubo: "fetch blocks (bitswap)"
gw -> own: "UPDATE is_pinned = 1, pin_requested_at"
gw -> cluster: "verify: GET /pins/cid, 3 polls 2 s apart"
gw -> gw: "two failed pins: Unregister, cluster Unpin\n(does not remove the local Kubo pin)"
