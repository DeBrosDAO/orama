shape: sequence_diagram

c: "Client"
gw: "Gateway handler"
db: "dns_nodes"
g1: "Guardian 1"
gn: "Guardian N"

c -> gw: "POST /v1/vault/push\nidentity, envelope, version, pubkey, signature"
gw -> gw: "400 unless identity is 64 hex\nper-IP bucket (30/min) before the proof"
gw -> gw: "verifyPush: identity = SHA-256(pubkey),\nEd25519 over vault-push-v1:identity:version"
gw -> gw: "per-identity bucket (burst 5, 30/h)"
gw -> db: "active nodes"
db -> gw: "N addresses"
gw -> gw: "K = max(2, N/3), W = min(N, max(K+1, ceil(2N/3)))\nN = 1: local key, K = 1, W = 1\nshamir.Split(envelope, N, K)"
gw -> g1: "auth/challenge, auth/session (per request)"
g1 -> gw: "session token"
gw -> g1: "POST /v1/vault/push\nshare = x byte + y, version, threshold K,\npubkey, signature, X-Session-Token"
g1 -> g1: "re-verify ownership\nversion greater than meta.json\nwrite share.bin, checksum.bin, meta.json"
g1 -> gw: "200 stored, or 409 (version), 401, 500"
gw -> gn: "same, with share x = N"
gn -> gw: "200 / error"
gw -> gw: "zero the shares\nacks >= W: 200 ok\nconflicts >= W: 409 version_conflict\notherwise 503 insufficient_quorum"
gw -> c: "PushResponse: status, ack_count, total, quorum, threshold"
