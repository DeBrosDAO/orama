shape: sequence_diagram

sd: "systemd"
main: "main.go"
node: "Node.Stop"
sup: "boot.Supervisor"
life: "lifecycle + cluster discovery"
rq: "RQLiteManager"
rqd: "rqlited @index"

sd -> main: "SIGTERM (stop job on orama-node.service)"
sd -> rqd: "PartOf: stop job queued for every orama-namespace unit, no ordering against orama-node"
main -> sup: "cancel(): run context done"
main -> node: "Stop()"
node -> node: "stopping = true"
node -> life: "EnterMaintenance(5 min), UpdateOwnMetadata\nonly if state is active or degraded"
node -> sup: "wait for bootDone, at most 10 s"
node -> life: "cluster discovery Stop, cancel reconnection loop,\npeer discovery Stop"
node -> node: "close libp2p host"
node -> rq: "adapter.Close() then Stop() (once)"
rq -> rqd: "GET /status, GET /nodes"
rq -> rqd: "POST /leader (5 s; a 404 means no step-down API), poll until not Leader (15 s)"
rq -> rq: "remove PID file"
node -> main: "return"
main -> sd: "process exits; units still up are killed after 60 s (TimeoutStopSec, KillMode=mixed)"
