direction: right

node: "orama-node.service"
wg: "wireguard@index\nno PartOf, ExecStop /bin/true"
rq: "rqlite@"
ol: "olric@"
gw: "gateway@"
ps: "pubsub@"
sfu: "sfu@"
turn: "turn@"
ipfs: "ipfs@"
ipfsc: "ipfs-cluster@"
gc: "ipfs-gc@ (oneshot, timer)"
vault: "vault@"
caddy: "caddy@"
sni: "sni-router@"
dns: "coredns@nameserver"
others: "every other supervised unit\nntfy, tor, ipfs-gc timer, orama-turn.service"

rq -> wg: "Wants + After"
ol -> wg: "Wants + After"
ps -> wg: "Wants + After"
turn -> wg: "Wants + After"
gw -> wg: "Wants + After"
gw -> rq: "Wants + After"
gw -> ol: "Wants + After"
sfu -> wg: "Wants + After"
sfu -> ol: "Wants + After"
ipfs -> wg: "After"
vault -> wg: "After"
ipfsc -> ipfs: "Requires + After"
gc -> ipfs: "Requires + After"
caddy -> gw: "After"
caddy -> dns: "After"
sni -> caddy: "Before"
dns -> rq: "After"
rq -> node: "PartOf"
ol -> node: "PartOf"
gw -> node: "PartOf"
caddy -> node: "PartOf"
others -> node: "PartOf"
ps -> node: "PartOf"
sfu -> node: "PartOf"
turn -> node: "PartOf"
ipfs -> node: "PartOf"
ipfsc -> node: "PartOf"
gc -> node: "PartOf"
vault -> node: "PartOf"
sni -> node: "PartOf"
dns -> node: "PartOf"
