shape: sequence_diagram

c: "caller"
h: "InvokeFunction"
iv: "Invoker"
rg: "Registry"
en: "Engine"
ex: "Executor"
w: "wazero instance"
q: "invocation log queue"

c -> h: "POST /v1/invoke/ns/fn (body at most 1 MiB)"
h -> h: "fn: selector, caller wallet, admin, invoke grant, device"
h -> iv: "Invoke(req) under a 60 s deadline"
iv -> iv: "checkServed: namespace is this gateway's"
iv -> rg: "Get(ns, name, version) - 5 s cache"
iv -> iv: "canInvokeFn unless SystemOriginated"
iv -> rg: "env vars - 5 s cache"
iv -> en: "Execute (attempt 1 .. RetryCount + 1)"
en -> en: "rate limit: per_function_wallet, per_wallet or per_ip, per_namespace"
en -> en: "deadline = min(function timeout, 60 s)"
en -> en: "module from cache or compile once"
en -> ex: "ExecuteModule (command mode)"
ex -> ex: "namespace slot, then process slot"
ex -> w: "instantiate: _start runs with stdin = input"
w -> en: "stdout bytes"
en -> q: "enqueue record (drop if 4096 pending)"
en -> iv: "output"
iv -> iv: "on failure: backoff, retry; then DLQ publish"
iv -> h: "response"
h -> c: "JSON output as is, or wrapped envelope"
