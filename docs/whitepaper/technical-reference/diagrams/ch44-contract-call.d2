shape: sequence_diagram

user: "signer"
ante: "ante chain"
wasmd: "x/wasm keeper"
eng: "depositEngine"
vm: "libwasmvm"
msgr: "Messenger"
dec: "wasmbindings.Decode"
mod: "module Msg server"
ledger: "x/wasmpolicy ledger"

user -> ante: "MsgExecuteContract"
ante -> ante: "UploadSunset, ContractSend, DepositPayer (first signer + budget)"
ante -> wasmd: "dispatch"
wasmd -> eng: "Execute"
eng -> vm: "run with MeteredStore"
vm -> wasmd: "result: CosmosMsg::Custom"
wasmd -> msgr: "DispatchMsg"
msgr -> msgr: "RejectDisabled: Any, Staking, SetWithdrawAddress, IBC"
msgr -> dec: "strict JSON, one variant, contract is signer"
dec -> msgr: "sdk.Msg"
msgr -> mod: "ValidateBasic, then the Msg handler"
eng -> ledger: "ApplyStateDelta(contract, payer, grew, shrank)"
ledger -> eng: "ok, or contract error: state deposit"
