shape: sequence_diagram

cli: "CLI / SDK"
gw: "Index gateway\n(home node)"
reg: "Registry (index RQLite)"
fs: "Deployment directory"
ipfs: "IPFS"
pm: "process.Manager"
unit: "Deployment unit"
rep: "Replica node"

cli -> gw: "POST /v1/deployments/TYPE/upload (multipart tarball, env_NAME fields)"
gw -> reg: "CheckNewDeploymentName: ValidateName, instance free?"
gw -> fs: "claimNewInstance: Mkdir + .orama-owner (exactly one create wins)"
gw -> ipfs: "Add tarball (static: extract, AddDirectory)"
gw -> fs: "fetch CID, tar -xzf --exclude=.orama-owner"
gw -> pm: "nodejs only: InstallDependencies (orama-deploy-build@)"
gw -> reg: "CreateDeployment: subdomain (generated, or the tenant's, unchecked); AllocatePort; seal env; register CIDs"
gw -> reg: "tx: INSERT deployments + deployment_history v1"
gw -> reg: "primary replica row (active); A record for the home node"
gw -> rep: "SelectReplicaNodes; goroutine: pending row, then POST replica/setup (concurrent with Start)"
gw -> pm: "Start"
pm -> unit: "stage env, bind port, token, limits; enable; start"
gw -> pm: "WaitForHealthy (unit active, up to 60 or 90 s)"
gw -> reg: "status = active"
gw -> cli: "201 Created: id, urls, version, port"
rep -> reg: "setup: allocate port, extract, start; replica row active + port"
gw -> reg: "on the setup answer: row active + replica A record"
