direction: right

ledgers: "x/fees state (ledgers)" {
  e: "Earnings\naddress to amount" {shape: cylinder}
  f: "FeeBalances\naddress to amount" {shape: cylinder}
  d: "Deposits\nid to owner, amount" {shape: cylinder}
  c: "Collected / Burned / Distributed" {shape: cylinder}
}
accts: "x/bank module accounts" {
  fa: "fees (Burner)"
  da: "fees_deposits (Burner)"
  ea: "emission (Minter)"
  ta: "token (Minter, Burner)"
}
ledgers.e -> accts.fa: "sum(Earnings) + sum(FeeBalances)\n== balance"
ledgers.f -> accts.fa
ledgers.d -> accts.da: "sum(Deposits) == balance"
ledgers.c -> ledgers.c: "burned + distributed == collected"
accts.ea -> accts.fa: "CreditEarnings via x/power,\nstorage, relay, houses, market"
accts.da -> accts.fa: "99% refund on release"
accts.fa -> accts.da: "deposit funded from the owner's earnings\nafter the bank balance"
