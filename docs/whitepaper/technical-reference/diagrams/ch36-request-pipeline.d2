shape: sequence_diagram

app: "application"
sub: "sub-client (db.query)"
http: "HttpClient.request"
auth: "AuthClient hooks"
gw: "gateway"

app -> sub: "query(sql, args)"
sub -> http: "POST /v1/rqlite/query"
http -> http: "send(): ensureToken()"
http -> auth: "key set, no JWT, no token: exchange"
auth -> gw: "POST /v1/auth/token\nAuthorization: Bearer key (ownCredential)"
gw -> auth: "access_token, expires_in"
auth -> http: "token cached, renewed 60 s before expiry"
http -> gw: "Authorization: Bearer token\ntimer starts: 60 s for the whole send"
gw -> http: "503 + Retry-After"
http -> http: "wait Retry-After (cap 30 s) or\nbase x attempt + up to 25% jitter"
http -> gw: "same request, attempt 2"
gw -> http: "401"
http -> auth: "refresher(): refresh() or re-exchange"
auth -> gw: "POST /v1/auth/refresh"
gw -> auth: "new access token"
http -> gw: "replay once, fresh timer"
gw -> http: "200 JSON"
http -> sub: "parsed body"
sub -> app: "rows"
