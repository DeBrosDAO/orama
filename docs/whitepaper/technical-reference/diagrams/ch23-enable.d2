shape: sequence_diagram

op: "owner / admin"
gw: "gateway\n/v1/namespace/webrtc/enable"
cm: "ClusterManager"
reg: "index RQLite"
local: "this host"
remote: "other TURN host"
sfus: "3 member nodes"

op -> gw: "POST enable"
gw -> cm: "EnableWebRTC(ns)"
cm -> reg: "cluster ready? not already enabled"
cm -> reg: "INSERT namespace_webrtc_config\n(32-byte secret, encrypted at rest)"
cm -> reg: "AllocateSFUPorts on each member (needs 3)"
cm -> reg: "AllocateTURNPorts on 2 members"
cm -> local: "ReconcileHostTURN"
cm -> remote: "reconcile-host-turn (confirm)"
remote -> cm: "ok only when running server serves ns"
cm -> cm: "no host confirmed: roll back, fail"
cm -> sfus: "spawn-sfu, one node at a time"
cm -> reg: "CreateTURNRecords for confirmed public IPs\n(turn.ns-NS and turn-NS)"
cm -> sfus: "save cluster-state.json"
cm -> sfus: "restart gateways with WebRTC config"
gw -> op: "200 WebRTC enabled"
