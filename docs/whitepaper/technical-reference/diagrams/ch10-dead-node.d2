shape: sequence_diagram

mon: "ring monitor\nlowest observer"
cm: "ClusterManager\nHandleDeadNode"
reg: "index RQLite"
surv: "surviving members\n(namespace rqlite)"
repl: "replacement node"

mon -> cm: "OnNodeDead(deadNodeID)"
cm -> reg: "dns_nodes.status = offline"
cm -> reg: "deployment_replicas active -> failed; deployments degraded or failed"
cm -> reg: "clusters of the node (status ready or degraded)"
cm -> reg: "per cluster: nodeIsLive? (active, last_seen within 2 min)"
cm -> reg: "live: member status running, settleClusterStatus (reinstate, stop here)"
cm -> reg: "cluster of size 1: member failed, cluster degraded, ErrEvalClusterNoReplacement, stop"
cm -> reg: "dead: member status failed, cluster degraded"
cm -> reg: "SelectReplacementNode (exclude all members), AllocatePortBlock"
cm -> surv: "guardRaftRemoval, then remove the dead raft address through a survivor (Admin Remove)"
cm -> repl: "spawn rqlite follower (-join a survivor), olric, gateway, per dead role"
cm -> reg: "insert membership rows only for spawns that succeeded"
cm -> reg: "UpdateNamespaceRecord old public IP -> new"
cm -> reg: "removeAndEvictMember: owed teardown row, delete membership, evict allocations"
cm -> surv: "updateClusterStateAfterRecovery: save-cluster-state to every member"
cm -> reg: "status ready only if no spawn error; else stays degraded"
