direction: down

start: "GET /v1/storage/get/cid"
canon: "canonical CID?"
own: "namespace owns CID?\nselector covers its name?"
local: "Kubo cat offline=true\n(2 s header timeout)"
pinset: "cluster GET /allocations/cid\n(3 s)"
net: "Kubo cat, networked\n(20 s total budget, local read included)"
ok: "200 octet-stream\nContent-Length"
e400: "400 VALIDATION_FAILED"
e403: "403 FORBIDDEN"
recent: "pin requested\nwithin 2 min?"
r404: "404 NOT_FOUND\nretryable"
f404: "404 NOT_FOUND\nfinal"
e503: "503 SERVICE_UNAVAILABLE"
e504: "504 TIMEOUT"
e500: "500 INTERNAL"

start -> canon
canon -> e400: "no"
canon -> own: "yes"
own -> e403: "no"
own -> local: "yes"
local -> ok: "held locally"
local -> e504: "no headers in 2 s"
local -> e500: "other Kubo failure"
local -> pinset: "not found locally"
pinset -> recent: "not in pinset"
recent -> r404: "yes"
recent -> f404: "no"
pinset -> e503: "pinset unreadable"
pinset -> net: "in pinset"
net -> ok: "fetched"
net -> e504: "deadline"
net -> e500: "stream failed"
