direction: down

q: "Query (qname lower-cased, qtype)"
zone: "qname inside a configured zone?"
next: "next plugin\n(the zone block has none: SERVFAIL)"
fresh: "fresh cache entry\n(TTL 30 s)?"
hit: "answer from cache\n(a negative entry keeps its rcode)"
exact: "SELECT exact name + type\nis_active = TRUE\n(one flight per name and type)"
berr: "backend error"
stale: "stale entry within 24 h?"
servestale: "serve stale answer, TTL 30 s"
servfail: "SERVFAIL"
found: "rows found?"
owners: "one indexed SELECT: what qname and its\nin-zone wildcards *.b.c.d, *.c.d, *.d own"
self: "qname owns a row of another type,\nor has names below it\n(in-memory ancestor set)?"
wild: "nearest wildcard that owns\nany row"
wtype: "wildcard has rows\nof the type?"
answer: "authoritative answer,\nowner = qname, cache 30 s"
nodata: "NODATA: NOERROR, no answer,\nzone SOA in authority\ncache 30 s, never served stale"
nx: "NXDOMAIN + zone SOA in authority\ncache 30 s, never served stale"
soa: "SOA lookup for the zone\n(error: stale or SERVFAIL)"

q -> zone
zone -> next: "no"
zone -> fresh: "yes"
fresh -> hit: "yes"
fresh -> exact: "no"
exact -> berr: "error"
berr -> stale
stale -> servestale: "yes"
stale -> servfail: "no"
exact -> found: "ok"
found -> answer: "yes"
found -> owners: "no"
owners -> berr: "error"
owners -> self
self -> soa: "yes (NODATA)"
self -> wild: "no"
wild -> wtype: "found"
wild -> soa: "none (NXDOMAIN)"
wtype -> answer: "yes"
wtype -> soa: "no (NODATA)"
soa -> nodata: "name exists"
soa -> nx: "name does not exist"
