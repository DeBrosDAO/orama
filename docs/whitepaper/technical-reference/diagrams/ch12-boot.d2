shape: sequence_diagram

main: "cmd/gateway main"
cfg: "parseGatewayConfig"
new: "gateway.New"
deps: "NewDependencies"
bg: "background goroutines"
srv: "http.Server"

main -> cfg: "--config gateway.yaml"
cfg -> cfg: "DecodeStrict; read cluster secret + identity.key;\napi_key_hmac_secret required; ValidateConfig"
cfg -> main: "gateway.Config (exit 1 on any error)"
main -> new: "New(logger, cfg)"
new -> deps: "NewDependencies"
deps -> deps: "ensureStateDir (0700); client.NewClient + Connect"
deps -> deps: "RQLite handles (lazy sql.Open, pool 25/5)"
deps -> deps: "Olric client, 5 attempts 0.5 s to 5 s"
deps -> deps: "IPFS client (keys derived from cluster secret)"
deps -> deps: "wait for registry leader (20 s), encryption root,\nserverless engine, push, signing keys, auth.Service"
deps -> new: "Dependencies (fatal on IPFS or auth failure)"
new -> new: "internal-auth key, registry client probe (15 s),\nhandlers, rate limiters, deployment system"
new -> bg: "startOlricSupervisor"
new -> bg: "startSchemaReadiness: converge, then after-ready steps"
new -> bg: "peer discovery or pubsub mesh; ring monitor, TLS store,\nnamespace health (all wait for ready); telemetry collector starts at once"
new -> main: "*Gateway (readiness = starting)"
main -> main: "index only: WireCoreGateway(gw, cfg)"
main -> srv: "gw.Routes(); bind WG address (+ 127.0.0.1 on index)"
srv -> bg: "serve; /health answers 503 starting until ready"
