direction: right

s1: "Hop check\nforged headers deleted"
s2: "Rate limit"
s3: "Readiness"
s4: "Host routing:\nvalidate credential in registry"
s5: "Find targets,\nbreaker check"
s6: "Namespace gateway:\nMAC, grant, scope, namespace limit"
s7: "Handler"

x2: "429 RATE_LIMITED" {shape: rectangle}
x3: "503 initializing or schema" {shape: rectangle}
x4: "401 AUTH_MISSING, AUTH_INVALID_KEY\n403 NAMESPACE_MISMATCH" {shape: rectangle}
x5: "404 gateway not found\n503 registry down or all circuits open" {shape: rectangle}
x6: "401, 403 INSUFFICIENT_SCOPE,\nOWNERSHIP_REQUIRED, 429" {shape: rectangle}

s1 -> s2 -> s3 -> s4 -> s5 -> s6 -> s7
s2 -> x2
s3 -> x3
s4 -> x4
s5 -> x5
s6 -> x6
