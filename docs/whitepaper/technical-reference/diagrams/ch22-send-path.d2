shape: sequence_diagram

caller: "caller\n(HTTP /v1/push/send,\nor push_send_v2)"
mgr: "Manager"
cache: "dispatcher cache\n(per namespace, 30 s)"
cfg: "ConfigStore +\ncredentials.Manager"
dev: "RqliteDeviceStore"
reg: "auth service\n(registry)"
disp: "PushDispatcher"
prov: "provider\n(apns, apns_voip, expo, ntfy)"

caller -> mgr: "SendToUserDetailed(ns, user, msg)"
mgr -> cache: "dispatcherFor(ns)"
cache -> cfg: "miss or expired:\nconfig + credentials"
cfg -> cache: "Config, apns/ntfy credentials"
cache -> mgr: "dispatcher, or ErrPushNotConfigured\n(no provider built)"
mgr -> disp: "SendToUserDetailed"
disp -> dev: "ListForUser(ns, user)"
dev -> reg: "RevokedDevices(session device ids)"
reg -> dev: "revoked set"
dev -> dev: "delete revoked rows,\ndecrypt tokens"
dev -> disp: "devices"
disp -> disp: "filter: target_provider wins\nover exclude_provider"
disp -> prov: "Send(msg + token), one device at a time"
prov -> disp: "nil, or PushError(status, reason, unregistered)"
disp -> caller: "SendDetailedResult:\nok, attempted, succeeded, results[]"
