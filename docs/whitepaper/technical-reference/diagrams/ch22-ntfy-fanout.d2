shape: sequence_diagram

prov: "ntfy provider\n(namespace gateway)"
res: "fan-out resolver"
reg: "index RQLite\ndns_nodes"
a: "node A\nindex gateway :10104"
b: "node B\nindex gateway :10104"
nta: "ntfy A\n127.0.0.1:10109"
ntb: "ntfy B\n127.0.0.1:10109"
sub: "subscriber\nvia push.zone, pinned to one\ndesignated nameserver node"

prov -> prov: "resolveTopic(token): bare topic,\nor UnifiedPush URL on the configured host"
prov -> res: "Targets()"
res -> reg: "id, internal_ip of active rows\n(cached 30 s)"
reg -> res: "rows; non-overlay addresses dropped"
res -> prov: "targets: http://10.0.0.x:10104"
prov -> a: "POST /v1/internal/push/ntfy/topic\nTitle, Priority, Tags, body, MAC v2 for A"
prov -> b: "POST same path, MAC v2 for B"
a -> a: "WireGuard source, MAC v2, topic pattern"
a -> nta: "POST /topic (3 headers + body)"
nta -> a: "200"
a -> prov: "200"
b -> ntb: "POST /topic"
ntb -> b: "refused or down"
b -> prov: "502"
prov -> prov: "okCount >= 1: success, warn about node B.\nokCount = 0: error"
nta -> sub: "message, if A is the designated node"
