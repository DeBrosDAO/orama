direction: right

none: "no row\n(never enrolled)"
live: "live\n(public_key, revoked_at NULL)"
revoked: "revoked\n(revoked_at set)"

none -> live: "enrol-key signed by identity.key"
live -> live: "same key again: unchanged"
live -> revoked: "orama node remove, or\nmembership reconciler drops dns_nodes row"
live -> none: "join under invite:\nDELETE FROM node_credentials"
revoked -> none: "join under invite:\nDELETE FROM node_credentials"
revoked -> revoked: "any enrol or stamp: refused"
live -> live: "different key: refused"
