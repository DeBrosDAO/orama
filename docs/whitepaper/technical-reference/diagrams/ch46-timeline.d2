direction: right

e0: "Epoch e in progress\nrelays measured; reporters not yet\nable to report e"
e1: "Epoch e+1 in progress\nreports for e accepted\n(ReportWindowEpochs = 1)"
e2: "Epoch e+2 begins\nfirst block: EndBlock settles e\n(one epoch per block)"
e0 -> e1: "x/emission closes e"
e1 -> e2: "window ends"
