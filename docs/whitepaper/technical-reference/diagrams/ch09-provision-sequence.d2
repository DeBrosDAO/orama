shape: sequence_diagram

client: "wallet client"
create: "CreateHandler"
cm: "ClusterManager"
reg: "index RQLite"
members: "member nodes\n(SpawnHandler + units)"

client -> create: "POST /v1/namespaces {name}"
create -> reg: "policy, name free, no pending teardown, wallet cap"
create -> reg: "INSERT namespaces, principal, owner grant (under cap)"
create -> cm: "ProvisionNamespaceCluster"
cm -> reg: "count fleet members, list eligible nodes -> chooseTenantBlueprint"
cm -> reg: "INSERT namespace_clusters status=provisioning"
cm -> create: "cluster_id, poll_url"
create -> client: "202 provisioning"
cm -> reg: "select nodes, AllocatePortBlock per node (retry up to 5 selections)"
cm -> members: "spawn-rqlite leader (fresh start), then followers with -join + join verify"
cm -> members: "Ready: raft Leader/Follower and SELECT 1, per node"
cm -> members: "spawn-olric on all nodes concurrently"
cm -> members: "Ready: Olric Stats, per node"
cm -> members: "spawn-gateway per node"
cm -> members: "Ready: /v1/health, per node"
cm -> reg: "upsert ns-name and wildcard A records, TTL 60"
cm -> members: "verifyClusterHealthy (90 s per probe)"
cm -> reg: "UPDATE status=ready"
cm -> members: "save-cluster-state (cluster-state.json, 0600)"
client -> cm: "GET /v1/namespace/status?id= (poll)"
