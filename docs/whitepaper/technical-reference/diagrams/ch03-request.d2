shape: sequence_diagram

client: "Client"
dns: "CoreDNS"
caddy: "Caddy (node A)"
idx: "Index gateway (node A)"
reg: "Index RQLite"
ns: "Namespace gateway (a member node, usually node A)"
cache: "Namespace Olric"

client -> dns: "1. A ns-acme.base"
dns -> client: "2. one A row per gateway node"
client -> caddy: "3. TLS, POST /v1/cache/put, Bearer token"
caddy -> idx: "4. HTTP to 127.0.0.1:10104, X-Internal-Auth-* stripped"
idx -> idx: "5. hop check, policy, logging, headers, rate limit, CORS, readiness"
idx -> idx: "6. host ns-acme: route is not MainGateway, proxy"
idx -> reg: "7. verify token, read scopes, find gateway targets"
reg -> idx: "8. namespace acme, scopes, ordered targets"
idx -> ns: "9. HTTP over WireGuard, hop headers + MAC"
ns -> ns: "10. verify MAC, authorize, scope, namespace rate limit"
ns -> cache: "11. Put gateway_cache:acme"
cache -> ns: "12. stored"
ns -> idx: "13. 200 status ok"
idx -> caddy: "14. response copied"
caddy -> client: "15. HTTPS response"
