shape: sequence_diagram

client: "client"
cg: "any namespace gateway"
db: "namespace RQLite"
reg: "index RQLite"
sfu: "owning SFU"
other: "other SFUs\nof the namespace"

client -> cg: "WSS /v1/webrtc/signal?room=R&jwt=T"
cg -> cg: "token validated, caller = sub + did;\nper-identity join limit 60/min, burst 20"
cg -> db: "require_admission? Lookup(room, user, device)"
db -> cg: "valid until, generation, muted"
cg -> cg: "seal ticket: ns, room, uid, did, muted,\nsink, iat, aexp, agen, exp = iat + 30 s"
cg -> reg: "SFU nodes of the namespace (cached 10 s)"
cg -> sfu: "GET /health?room=R on every SFU (1.5 s)"
sfu -> cg: "200 {hasRoom} or 503 draining"
cg -> cg: "owner = first healthy that hosts R,\nelse top rendezvous rank"
cg -> sfu: "upgrade /ws/signal?room=R\nX-Orama-SFU-Ticket"
sfu -> sfu: "ticket MAC, expiry, namespace,\nkick log"
client -> sfu: "join {roomId} (within 10 s)"
sfu -> sfu: "room_mismatch checks; AddPeer;\nkick log again; arm admission expiry"
sfu -> client: "welcome {peerId, participants}"
sfu -> client: "turn-credentials"
sfu -> client: "track-added x N, offer"
sfu -> cg: "POST /v1/internal/webrtc/events join\n(queued, ordered)"
cg -> db: "publish _orama/webrtc/R"
