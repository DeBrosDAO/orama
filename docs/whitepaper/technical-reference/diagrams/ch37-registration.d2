shape: sequence_diagram

opr: "operator (RootWallet agent)"
cli: "orama global (operator's machine)"
node: "global node (provider / archiver)"
rest: "chain REST 31003"
nodes: "x/nodes MsgServer"
fees: "x/fees"
bank: "bank + nodes module account"

node -> node: "first start creates hot-key (0600), logs its address"
cli -> cli: "bind: sign orama-global-bind-v1|chain-id|operator|service|hex(pubkey)\nfor each service key and for hot-key"
cli -> cli: "register: verify each binding locally, ValidateNode"
cli -> rest: "GET account number, sequence, pubkey"
cli -> opr: "SignOramaTx(sign document)"
opr -> cli: "signature (address must equal operator)"
cli -> rest: "broadcast MsgRegisterNode"
rest -> nodes: "block executes"
nodes -> nodes: "operator registered? id free? hot key valid and unused?\nendpoints public and unclaimed? bindings verify against chain id?\npubkeys never used or revoked?"
nodes -> fees: "LockDeposit(operator, deposit_per_byte x record size)"
nodes -> nodes: "status registered; index pubkeys, hot key, literal IPs"
cli -> rest: "poll tx every 1 s, up to 2 min: returns at block inclusion"
cli -> rest: "bond --role ROLE --amount N  (MsgBondNode)"
nodes -> bank: "earnings top-up if short, then operator -> nodes module"
nodes -> nodes: "bond >= min_bond for a role: status active"
cli -> rest: "capacity --bytes N  (MsgDeclareCapacity, STORAGE only)"
nodes -> nodes: "N <= bond x 1 GiB / bond_per_gib (or probation cap) and N >= reserved"
